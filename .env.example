# This is a Next.js app: browser-exposed vars use the NEXT_PUBLIC_ prefix and are
# inlined at BUILD time, so they must be set in the deploy/build environment.

# This app's backend (accounts, login, catalog, shelves, friends). It is the
# identity provider: it sets the session cookies on login. A different origin in
# prod, so set it to the backend's TLS host (empty = same origin).
NEXT_PUBLIC_LIBRARY_API_URL=https://api.example.com

# Build-time switch for the Horizon UI (menu items, badge, /horizon page). Anything
# but 1 or true — including leaving it out — keeps it off.
HORIZON_ON=0

# Optional external platform API. Only cover uploads and admin role management
# still call it; it must be the API's own host with CORS allowing this app's origin.
NEXT_PUBLIC_PLATFORM_API_URL=https://platform-api.example.com

# Google Books API key for ISBN autofill (avoids the shared keyless 429).
NEXT_PUBLIC_GOOGLE_BOOKS_KEY=

# Server-side base URL the Next.js server uses to fetch public catalog data for
# the SSR /b and /m pages (no "same origin" on the server). Usually the same
# backend as NEXT_PUBLIC_LIBRARY_API_URL.
LIBRARY_SERVER_URL=https://api.example.com

# Canonical/OpenGraph origin for the SSR pages (link previews, <link canonical>).
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Local dev example:
# NEXT_PUBLIC_LIBRARY_API_URL=http://localhost:8081
# NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080
# LIBRARY_SERVER_URL=http://localhost:8081
# NEXT_PUBLIC_SITE_URL=http://localhost:5173
